#---------- MOB KILL PASSIVI E NEUTRALI ----------#     
on death of chicken, cow, pig, rabbit or sheep:
    if victim is chicken:
        set {_victim} to "GALLINA"
    if victim is cow:
        set {_victim} to "MUCCA"
    if victim is pig:
        set {_victim} to "MAIALE"
    if victim is rabbit:
        set {_victim} to "CONIGLIO"
    if victim is sheep:
        set {_victim} to "PECORA" 
    set {_fame} to random number between 0.1 and 0.5
    if attacker is a player:
        if gamemode of attacker is survival or adventure:
            if world is "%{server.world.overworld}%":
                if difficulty is easy:
                    remove ({_fame} * 1) from {fame::%attacker%}
                    send action bar "&4☠ &4&l%{_victim}% &c-%regex({_fame})% Fama &6(%regex({fame::%attacker%})% totale)" to attacker
                    stop
                else if difficulty is normal:
                    remove ({_fame} * 1.5) from {fame::%attacker%}
                    send action bar "&4☠ &4&l%{_victim}% &c-%regex({_fame})% Fama &6(%regex({fame::%attacker%})% totale)" to attacker
                    stop
                else if difficulty is hard:
                    remove ({_fame} * 2) from {fame::%attacker%}
                    send action bar "&4☠ &4&l%{_victim}% &c-%regex({_fame})% Fama &6(%regex({fame::%attacker%})% totale)" to attacker
                    stop
            else if world is "%{server.world.nether}%":
                if difficulty is easy:
                    remove ({_fame} * 1) from {fame::%attacker%}
                    send action bar "&4☠ &4&l%{_victim}% &c-%regex({_fame})% Fama &6(%regex({fame::%attacker%})% totale)" to attacker
                    stop
                else if difficulty is normal:
                    remove ({_fame} * 1.5) from {fame::%attacker%}
                    send action bar "&4☠ &4&l%{_victim}% &c-%regex({_fame})% Fama &6(%regex({fame::%attacker%})% totale)" to attacker
                    stop
                else if difficulty is hard:
                    remove ({_fame} * 2) from {fame::%attacker%}
                    send action bar "&4☠ &4&l%{_victim}% &c-%regex({_fame})% Fama &6(%regex({fame::%attacker%})% totale)" to attacker
                    stop
            else if world is "%{server.world.end}%":
                if difficulty is easy:
                    remove ({_fame} * 1) from {fame::%attacker%}
                    send action bar "&4☠ &4&l%{_victim}% &c-%regex({_fame})% Fama &6(%regex({fame::%attacker%})% totale)" to attacker
                    stop
                else if difficulty is normal:
                    remove ({_fame} * 1.5) from {fame::%attacker%}
                    send action bar "&4☠ &4&l%{_victim}% &c-%regex({_fame})% Fama &6(%regex({fame::%attacker%})% totale)" to attacker
                    stop
                else if difficulty is hard:
                    remove ({_fame} * 2) from {fame::%attacker%}
                    send action bar "&4☠ &4&l%{_victim}% &c-%regex({_fame})% Fama &6(%regex({fame::%attacker%})% totale)" to attacker
                    stop
