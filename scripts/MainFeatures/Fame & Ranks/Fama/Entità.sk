#---------- MOB KILL OSTILI ----------#
on death of zombie, husk, drowned or zombified piglin:
    if victim is zombie:
        set {_victim} to "ZOMBI"
    if victim is husk:
        set {_victim} to "ZOMBI SECCO"
    if victim is zombified piglin:
        set {_victim} to "PIGLIN ZOMBIFICATO"
