on inventory click:
    if name of event-inventory is "Reputazioni dell'%{server.name}%":
        if type of event-inventory is chest inventory:
            if index of event-slot isn't 49:
                cancel event
            else:
                if click type is left mouse button:
                    cancel event
                    close player's inventory
                else:
                    cancel event