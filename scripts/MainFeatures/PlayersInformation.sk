options:
    glinted: "{enchantment_glint_override:true}"
    no_flags: "{hide_additional_tooltip:{}}"

    gui_background: yaml value "personalization.gui_background.enabled" in "settings-%{_p}'s uuid%"

    genre: yaml value "genre" in "settings-%player's uuid%"
    genre_p: yaml value "genre" in "settings-%{_p}'s uuid%"

    can_view_other_profiles: yaml value "personalization.can_view_other_profiles.enabled" in "settings-%player's uuid%"
    can_others_view_self_profile: yaml value "privacy.can_others_view_self_profile.enabled" in "settings-%player's uuid%"

on right click on player:
    if player's tool is air:
        if player's offhand is shield:
            cancel event
        if {@can_view_other_profiles} is true:
            if {@can_others_view_self_profile} is false:
                PlayersInformation(player,event-entity)
            else:
                send "%{server.prefix.main}% &cNon puoi consultare il profilo di &6%event-entity%&c!" to player# &cperché l'ha disattivato dalle sue impostazioni di privacy!" to player
                send "%{server.prefix.main}% &cProbabilmente l'ha impedito dalle sue impostazioni di privacy." to player
                play sound "entity.enderman.teleport" with volume 1 and pitch 0 at player for player
        else:
            send "%{server.prefix.main}% &cNon puoi consultare il profilo di &6%event-entity%&c!" to player# &cperché hai disattivato l'opzione nelle tue impostazioni!" to player
            send "%{server.prefix.main}% &cProbabilmente non hai abilitato l'opzione ""&fProfilo giocatori&c"" dalle tue impostazioni." to player
            play sound "entity.enderman.teleport" with volume 1 and pitch 0 at player for player
            

function PlayersInformation(p: player, e: entity):
    set {_player_hp} to placeholder "auraskills_hp" from {_e}
    set {_player_hp_max} to placeholder "auraskills_hp_max" from {_e}
    set {_player_xp} to placeholder "player_current_exp" from {_e}
    set {_player_xp_level} to placeholder "player_level" from {_e}
    set {_player_inventory} to placeholder "player_empty_slots" from {_e}
    set {_player_biome} to placeholder "player_biome_capitalized" from {_e}
    set {_player_luck} to placeholder "auraskills_luck" from {_e}
    set {_player_health} to placeholder "auraskills_health" from {_e}
    set {_player_wisdom} to placeholder "auraskills_wisdom" from {_e}
    set {_player_strength} to placeholder "auraskills_strength" from {_e}
    set {_player_regeneration} to placeholder "auraskills_regeneration" from {_e}
    set {_player_toughness} to placeholder "auraskills_toughness" from {_e}
    set {_player_crit_chance} to placeholder "auraskills_crit_chance" from {_e}
    set {_player_crit_damage} to placeholder "auraskills_crit_damage" from {_e}
    set {_player_speed} to placeholder "auraskills_speed" from {_e}
    set {_player_hp_self} to placeholder "auraskills_hp" from {_p}
    set {_player_hp_max_self} to placeholder "auraskills_hp_max" from {_p}
    set {_player_xp_self} to placeholder "player_current_exp" from {_p}
    set {_player_xp_level_self} to placeholder "player_level" from {_p}
    set {_player_luck_self} to placeholder "auraskills_luck" from {_p}
    set {_player_health_self} to placeholder "auraskills_health" from {_p}
    set {_player_wisdom_self} to placeholder "auraskills_wisdom" from {_p}
    set {_player_strength_self} to placeholder "auraskills_strength" from {_p}
    set {_player_regeneration_self} to placeholder "auraskills_regeneration" from {_p}
    set {_player_toughness_self} to placeholder "auraskills_toughness" from {_p}
    set {_player_crit_chance_self} to placeholder "auraskills_crit_chance" from {_p}
    set {_player_crit_damage_self} to placeholder "auraskills_crit_damage" from {_p}
    set {_player_speed_self} to placeholder "auraskills_speed" from {_p}
    set {_genre} to {@genre_p}
    if {@gui_background} is true:
        set metadata tag "PlayersInformationGUI" of {_p} to a new chest inventory with 6 rows named "&rProfilo di %{_e}%"
        set slot 0, 1, 2, 5, 6, 7, 8, 9, 17, 18, 26, 27, 35, 36, 44, 45, 46, 47, 48, 50, 51, 52 and 53 of metadata tag "PlayersInformationGUI" of {_p} to black stained glass pane named "&r"
        set slot 10, 12, 13, 14, 22, 23, 27, 28, 30, 31, 32, 34, 37, 39, 40, 41, 42 and 43 of metadata tag "PlayersInformationGUI" of {_p} to gray stained glass pane named "&r"
        set slot 3 of metadata tag "PlayersInformationGUI" of {_p} to paper named "&bInfo" with lore "&7I valori tra parentesi sono quelli" and "&7delle tue statistiche."
        if {@genre_p} is "%{server.genre.male}%":
            set slot 4 of metadata tag "PlayersInformationGUI" of {_p} to {_e}'s head named "&9%{_e}%" with lore "&7""%{status.%{_e}%}%&7""", "&f", " &e➹ Bug segnalati&7: &f%{reported_bugs::%{_e}%}% &8(%{reported_bugs::%{_p}%}%)", " &6★ Feedback inviati&7: &f%{feedback_sent::%{_e}%}% &8(%{feedback_sent::%{_p}%}%)", "&f", " &a❉ EXP&7: &2%{_player_xp_level}% livelli (&a%{_player_xp}% punti&2) &8(%{_player_xp_level_self}% (%{_player_xp_self}%))", "&f" and "&7Prima volta nel server: &f%{playtime.first_login.%{_e}%}%"
        else if {@genre_p} is "%{server.genre.female}%":
            set slot 4 of metadata tag "PlayersInformationGUI" of {_p} to {_e}'s head named "&d%{_e}%" with lore "&7""%{status.%{_e}%}%&7""", "&f", " &e➹ Bug segnalati&7: &f%{reported_bugs::%{_e}%}% &8(%{reported_bugs::%{_p}%}%)", " &6★ Feedback inviati&7: &f%{feedback_sent::%{_e}%}% &8(%{feedback_sent::%{_p}%}%)", "&f", " &a❉ EXP&7: &2%{_player_xp_level}% livelli (&a%{_player_xp}% punti&2) &8(%{_player_xp_level_self}% (%{_player_xp_self}%))", "&f" and "&7Prima volta nel server: &f%{playtime.first_login.%{_e}%}%"
        if slot 39 of {_e}'s inventory is air:
            set slot 11 of metadata tag "PlayersInformationGUI" of {_p} to red stained glass pane named "&cSlot elmetto" with lore "&6%{_e}% &7non sta" and "&7indossando nessun elmetto."
        else:
            set slot 11 of metadata tag "PlayersInformationGUI" of {_p} to {_e}'s helmet
        if slot 38 of {_e}'s inventory is air:
            set slot 20 of metadata tag "PlayersInformationGUI" of {_p} to red stained glass pane named "&cSlot corazza" with lore "&6%{_e}% &7non sta" and "&7indossando nessuna corazza."
        else:
            set slot 20 of metadata tag "PlayersInformationGUI" of {_p} to {_e}'s chestplate
        if slot 37 of {_e}'s inventory is air:
            set slot 29 of metadata tag "PlayersInformationGUI" of {_p} to red stained glass pane named "&cSlot gambiere" with lore "&6%{_e}% &7non sta" and "&7indossando gambiere."
        else:
            set slot 29 of metadata tag "PlayersInformationGUI" of {_p} to {_e}'s leggings
        if slot 36 of {_e}'s inventory is air:
            set slot 38 of metadata tag "PlayersInformationGUI" of {_p} to red stained glass pane named "&cSlot stivali" with lore "&6%{_e}% &7non sta" and "&7indossando stivali."
        else:
            set slot 38 of metadata tag "PlayersInformationGUI" of {_p} to {_e}'s boots
        if slot 40 of {_e}'s inventory is air:
            set slot 19 of metadata tag "PlayersInformationGUI" of {_p} to magenta stained glass pane named "&dMano secondaria" with lore "&6%{_e}% &7non ha" and "&7oggetti nella seconda mano."
        else:
            set slot 19 of metadata tag "PlayersInformationGUI" of {_p} to {_e}'s off hand item
        if {_e}'s tool is air:
            set slot 21 of metadata tag "PlayersInformationGUI" of {_p} to lime stained glass pane named "&aMano principale" with lore "&6%{_e}% &7non ha" and "&7nulla in mano."
        else:
            set slot 21 of metadata tag "PlayersInformationGUI" of {_p} to {_e}'s held item
        set slot 15 of metadata tag "PlayersInformationGUI" of {_p} to writable book named "&bInformazioni generali" with lore " &9✎ Nome&7: &f%{_e}%", " &6✎ Soprannome&7: &f%{nick.%{_e}%}%", " &a✧ Sesso&7: &f%{_genre}%", " &e₪ Inventario&7: &f%{_player_inventory}%/35 slot liberi", " &b🌅 Bioma&7: &f%{_player_biome}%", " &3ℹ Ping&7: &f%{_e}'s ping% ms &8(%{_p}'s ping% ms)", " &d✦ Fama&7: &f%regex({fame::%{_e}%})% &8(%regex({fame::%{_p}%})%)", " &a✪ Reputazione&7: &f%{rank.%{_e}%}% &8(%{rank.%{_p}%}%&8)", " &2☘ Fortuna&7: &f+%{_player_luck}% &8(+%{_player_luck_self}%)", " &c❣ &cIncremento salute&7: &f+%{_player_health}% &8(+%{_player_health_self}%)", " &9✿ Saggezza&7: &f+%{_player_wisdom}% &8(+%{_player_wisdom_self}%)" and " &f➤ Velocità&7: &f+%{_player_speed}% &8(+%{_player_speed_self}%)"
        set slot 16 of metadata tag "PlayersInformationGUI" of {_p} to diamond sword with nbt from {@no_flags} named "&aStatistiche sanguinarie" with lore " &c🗡 Uccisioni&7: &f%regex({kills::%{_e}%})% &8(%regex({kills::%{_p}%})%)", " &c☠ Morti&7: &f%regex({deaths::%{_e}%})% &8(%regex({deaths::%{_p}%})%)", " &c🔥 Rapporto U/M&7: &f%regex({kills::%{_e}%}/{deaths::%{_e}%})% &8(%regex({kills::%{_p}%}/{deaths::%{_p}%})%)", " &6🗡 Danni inflitti&7: &f%regex({infldamage::%{_e}%})% &8(%regex({infldamage::%{_p}%})%)", " &6☄ Danni subiti&7: &f%regex({suffdamage::%{_e}%})% &8(%regex({suffdamage::%{_p}%})%)", " &e&l⚡ &eSerie di uccisioni&7: &f%regex({killstreak::%{_e}%})%/%regex({killstreak_max.%{_e}%})% &8(%regex({killstreak::%{_p}%})%/%regex({killstreak_max.%{_p}%})%)", " &4➽ Forza&7: &f+%{_player_strength}% &8(+%{_player_strength_self}%)", " &6❥ Rigenerazione&7: &f+%{_player_regeneration}% &8(+%{_player_regeneration_self}%)", " &5✦ Resistenza&7: &f+%{_player_toughness}% &8(+%{_player_toughness_self}%)", " &a⌘ Probabilità Colpo Critico&7: &f+%{_player_crit_chance}%%% &8(+%{_player_crit_chance_self}%%%)" and " &3★ Danno Colpo Critico&7: &f+%{_player_crit_damage}%%% &8(+%{_player_crit_damage_self}%%%)"
        set slot 24 of metadata tag "PlayersInformationGUI" of {_p} to iron pickaxe with nbt from {@no_flags} named "&aStatistiche minerarie" with lore " &c⛏ Blocchi distrutti&7: &f%regex({broken_blocks::%{_e}%})% &8(%regex({broken_blocks::%{_p}%})%)" and " &b🔨 Blocchi piazzati&7: &f%regex({placed_blocks::%{_e}%})% &8(%regex({placed_blocks::%{_p}%})%)"
        set slot 25 of metadata tag "PlayersInformationGUI" of {_p} to sunflower with nbt from {@glinted} named "&eMedaglie" with lore " &6۞ Ottenute&7: &f%{medals.%{_e}%}% &8(%{medals.%{_p}%}%)" and " &e✪ Ultima ottenuta&7: &f%{medals.%{_e}%.last_obtained}% &8(%{medals.%{_e}%.last_obtained}%&8)"
        set slot 49 of metadata tag "PlayersInformationGUI" of {_p} to barrier named "&cChiudi" with lore "&7Torna alla %{server.name}%"
        open metadata tag "PlayersInformationGUI" of {_p} to {_p}
    else:
        set metadata tag "PlayersInformationGUI" of {_p} to a new chest inventory with 6 rows named "&rProfilo di %{_e}%"
        set slot 3 of metadata tag "PlayersInformationGUI" of {_p} to paper named "&bInfo" with lore "&7I valori tra parentesi sono quelli" and "&7delle tue statistiche."
        if {@genre_p} is "%{server.genre.male}%":
            set slot 4 of metadata tag "PlayersInformationGUI" of {_p} to {_e}'s head named "&9%{_e}%" with lore "&7""%{status.%{_e}%}%&7""", "&f", " &e➹ Bug segnalati&7: &f%{reported_bugs::%{_e}%}% &8(%{reported_bugs::%{_p}%}%)", " &6★ Feedback inviati&7: &f%{feedback_sent::%{_e}%}% &8(%{feedback_sent::%{_p}%}%)", "&f", " &a❉ EXP&7: &2%{_player_xp_level}% livelli (&a%{_player_xp}% punti&2) &8(%{_player_xp_level_self}% (%{_player_xp_self}%))", "&f" and "&7Prima volta nel server: &f%{playtime.first_login.%{_e}%}%"
        else if {@genre_p} is "%{server.genre.female}%":
            set slot 4 of metadata tag "PlayersInformationGUI" of {_p} to {_e}'s head named "&d%{_e}%" with lore "&7""%{status.%{_e}%}%&7""", "&f", " &e➹ Bug segnalati&7: &f%{reported_bugs::%{_e}%}% &8(%{reported_bugs::%{_p}%}%)", " &6★ Feedback inviati&7: &f%{feedback_sent::%{_e}%}% &8(%{feedback_sent::%{_p}%}%)", "&f", " &a❉ EXP&7: &2%{_player_xp_level}% livelli (&a%{_player_xp}% punti&2) &8(%{_player_xp_level_self}% (%{_player_xp_self}%))", "&f" and "&7Prima volta nel server: &f%{playtime.first_login.%{_e}%}%"
        if slot 39 of {_e}'s inventory is air:
            set slot 11 of metadata tag "PlayersInformationGUI" of {_p} to red stained glass pane named "&cSlot elmetto" with lore "&6%{_e}% &7non sta" and "&7indossando nessun elmetto."
        else:
            set slot 11 of metadata tag "PlayersInformationGUI" of {_p} to {_e}'s helmet
        if slot 38 of {_e}'s inventory is air:
            set slot 20 of metadata tag "PlayersInformationGUI" of {_p} to red stained glass pane named "&cSlot corazza" with lore "&6%{_e}% &7non sta" and "&7indossando nessuna corazza."
        else:
            set slot 20 of metadata tag "PlayersInformationGUI" of {_p} to {_e}'s chestplate
        if slot 37 of {_e}'s inventory is air:
            set slot 29 of metadata tag "PlayersInformationGUI" of {_p} to red stained glass pane named "&cSlot gambiere" with lore "&6%{_e}% &7non sta" and "&7indossando gambiere."
        else:
            set slot 29 of metadata tag "PlayersInformationGUI" of {_p} to {_e}'s leggings
        if slot 36 of {_e}'s inventory is air:
            set slot 38 of metadata tag "PlayersInformationGUI" of {_p} to red stained glass pane named "&cSlot stivali" with lore "&6%{_e}% &7non sta" and "&7indossando stivali."
        else:
            set slot 38 of metadata tag "PlayersInformationGUI" of {_p} to {_e}'s boots
        if slot 40 of {_e}'s inventory is air:
            set slot 19 of metadata tag "PlayersInformationGUI" of {_p} to magenta stained glass pane named "&dMano secondaria" with lore "&6%{_e}% &7non ha" and "&7oggetti nella seconda mano."
        else:
            set slot 19 of metadata tag "PlayersInformationGUI" of {_p} to {_e}'s off hand item
        if {_e}'s tool is air:
            set slot 21 of metadata tag "PlayersInformationGUI" of {_p} to lime stained glass pane named "&aMano principale" with lore "&6%{_e}% &7non ha" and "&7nulla in mano."
        else:
            set slot 21 of metadata tag "PlayersInformationGUI" of {_p} to {_e}'s held item
        set slot 15 of metadata tag "PlayersInformationGUI" of {_p} to writable book named "&bInformazioni generali" with lore " &9✎ Nome&7: &f%{_e}%", " &6✎ Soprannome&7: &f%{nick.%{_e}%}%", " &a✧ Sesso&7: &f%{_genre}%", " &e₪ Inventario&7: &f%{_player_inventory}%/35 slot liberi", " &b🌅 Bioma&7: &f%{_player_biome}%", " &3ℹ Ping&7: &f%{_e}'s ping% ms &8(%{_p}'s ping% ms)", " &d✦ Fama&7: &f%regex({fame::%{_e}%})% &8(%regex({fame::%{_p}%})%)", " &a✪ Reputazione&7: &f%{rank.%{_e}%}% &8(%{rank.%{_p}%}%&8)", " &2☘ Fortuna&7: &f+%{_player_luck}% &8(+%{_player_luck_self}%)", " &c❣ &cIncremento salute&7: &f+%{_player_health}% &8(+%{_player_health_self}%)", " &9✿ Saggezza&7: &f+%{_player_wisdom}% &8(+%{_player_wisdom_self}%)" and " &f➤ Velocità&7: &f+%{_player_speed}% &8(+%{_player_speed_self}%)"
        set slot 16 of metadata tag "PlayersInformationGUI" of {_p} to diamond sword with nbt from {@no_flags} named "&aStatistiche sanguinarie" with lore " &c🗡 Uccisioni&7: &f%regex({kills::%{_e}%})% &8(%regex({kills::%{_p}%})%)", " &c☠ Morti&7: &f%regex({deaths::%{_e}%})% &8(%regex({deaths::%{_p}%})%)", " &c🔥 Rapporto U/M&7: &f%regex({kills::%{_e}%}/{deaths::%{_e}%})% &8(%regex({kills::%{_p}%}/{deaths::%{_p}%})%)", " &6🗡 Danni inflitti&7: &f%regex({infldamage::%{_e}%})% &8(%regex({infldamage::%{_p}%})%)", " &6☄ Danni subiti&7: &f%regex({suffdamage::%{_e}%})% &8(%regex({suffdamage::%{_p}%})%)", " &e&l⚡ &eSerie di uccisioni&7: &f%regex({killstreak::%{_e}%})%/%regex({killstreak_max.%{_e}%})% &8(%regex({killstreak::%{_p}%})%/%regex({killstreak_max.%{_p}%})%)", " &4➽ Forza&7: &f+%{_player_strength}% &8(+%{_player_strength_self}%)", " &6❥ Rigenerazione&7: &f+%{_player_regeneration}% &8(+%{_player_regeneration_self}%)", " &5✦ Resistenza&7: &f+%{_player_toughness}% &8(+%{_player_toughness_self}%)", " &a⌘ Probabilità Colpo Critico&7: &f+%{_player_crit_chance}%%% &8(+%{_player_crit_chance_self}%%%)" and " &3★ Danno Colpo Critico&7: &f+%{_player_crit_damage}%%% &8(+%{_player_crit_damage_self}%%%)"
        set slot 24 of metadata tag "PlayersInformationGUI" of {_p} to iron pickaxe with nbt from {@no_flags} named "&aStatistiche minerarie" with lore " &c⛏ Blocchi distrutti&7: &f%regex({broken_blocks::%{_e}%})% &8(%regex({broken_blocks::%{_p}%})%)" and " &b🔨 Blocchi piazzati&7: &f%regex({placed_blocks::%{_e}%})% &8(%regex({placed_blocks::%{_p}%})%)"
        set slot 25 of metadata tag "PlayersInformationGUI" of {_p} to sunflower with nbt from {@glinted} named "&eMedaglie" with lore " &6۞ Ottenute&7: &f%{medals.%{_e}%}% &8(%{medals.%{_p}%}%)" and " &e✪ Ultima ottenuta&7: &f%{medals.%{_e}%.last_obtained}% &8(%{medals.%{_e}%.last_obtained}%&8)"
        set slot 49 of metadata tag "PlayersInformationGUI" of {_p} to barrier named "&cChiudi" with lore "&7Torna alla %{server.name}%"
        open metadata tag "PlayersInformationGUI" of {_p} to {_p}

on inventory click:
    if event-inventory is (metadata tag "PlayersInformationGUI" of player):
        if type of event-inventory is chest inventory:
            if index of event-slot isn't 49:
                cancel event
            else:
                if click type is left mouse button:
                    cancel event
                    close player's inventory
                else:
                    cancel event