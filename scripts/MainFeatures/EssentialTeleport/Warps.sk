# VERSIONE 1.1
# NOVITÀ v1.1: INTRODUZIONE DEI WARP RINOMINABILI
#
# PERMESSI
#
# et.member.warp
# et.member.warps
# et.member.renwarp
# et.member.renlockwarp
# et.member.warpinfo
# et.member.warphelp
# et.admin.setwarp
# et.admin.setlockwarp
# et.admin.delwarp
# et.admin.dellockwarp
# et.admin.movewarp
# et.admin.movelockwarp
# et.admin.lockwarp
# et.admin.unlockwarp
# et.admin.renwarp
