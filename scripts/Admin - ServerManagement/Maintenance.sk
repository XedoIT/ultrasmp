function ToggleMaintenanceConsole_NoReason(s: sender):
    if {maintenance} isn't set:
        set {maintenance} to true
        set {maintenance.reason} to "{@default_reason}"
        broadcast ""
        broadcast "{@debug_prefix} &6Manutenzione &aattivata &6dalla console."
        broadcast "{@debug_prefix} &cMotivo: {@default_reason}"
        broadcast ""
        broadcast "&c&lTutti i giocatori sono stati espulsi dal server."
        stop
    else if {maintenance} is true:
        delete {maintenance}
        delete {maintenance.reason}
        broadcast ""
        broadcast "{@debug_prefix} &6Manutenzione &cdisattivata &6dalla console."
        broadcast ""
        broadcast "&a&lI giocatori possono rientrare nel server."
        stop

every 10 ticks:
    loop all players:
        if {maintenance} is set:
            if {actionbar.maintenance.%loop-player%} is true:
                send action bar "&c&l---&7&l{ &6Manutenzione: &a&lATTIVATA &7&l}&c&l---" to loop-player