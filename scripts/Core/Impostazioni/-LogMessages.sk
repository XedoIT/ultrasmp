                if click type is left mouse button:
                    cancel event
                    if {logmsg.info.%player%} is not "{@funny}":
                        set {logmsg.info.%player%} to "{@funny}"
                        send "&6Hai selezionato: {@funny}&6!"
                        play sound "{@confirm_sound}" with volume 1 and pitch 2 at player for player
                        openLogMessagesGui_1(player)
                    else:
                        send "&cHai già selezionato questo pacchetto di messaggi!"
                        play sound "{@error_sound}" with volume 1 and pitch 0 at player for player
                else:
                    cancel event
                if click type is right mouse button:
