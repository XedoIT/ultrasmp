on inventory click:
    if name of event-inventory is "Messaggi in/out (1/1)":
        if type of event-inventory is chest inventory:
            if index of event-slot is not 10, 11, 12, 13, 14, 15, 16, 19, 20, 21, 22, 23, 24, 25, 48, 49 or 53:
                cancel event

            else if index of event-slot is 10:
                if click type is left mouse button:
                    cancel event
                    if {logmsg.info.%player%} is not "{@none}":
                        set {logmsg.info.%player%} to "{@none}"
                        send "&6Hai disattivato i tuoi messaggi di ingresso e uscita dal server!"
                        play sound "{@confirm_sound}" with volume 1 and pitch 2 at player for player
                        openLogMessagesGui_1(player)
                    else:
                        send "&cHai già selezionato questo pacchetto di messaggi!"
                        play sound "{@error_sound}" with volume 1 and pitch 0 at player for player
                else:
                    cancel event
                if click type is right mouse button:
                    cancel event
                    send "&cPer questo pacchetto non è disponibile nessun'anteprima."
                    play sound "{@error_sound}" with volume 1 and pitch 0 at player for player
                else:
                    cancel event

            else if index of event-slot is 11:
                if click type is left mouse button:
                    cancel event
                    if {logmsg.info.%player%} is not "{@smp}":
                        set {logmsg.info.%player%} to "{@smp}"
                        send "&6Hai selezionato: {@smp}&6!"
                        play sound "{@confirm_sound}" with volume 1 and pitch 2 at player for player
                        openLogMessagesGui_1(player)
                    else:
                        send "&cHai già selezionato questo pacchetto di messaggi!"
                        play sound "{@error_sound}" with volume 1 and pitch 0 at player for player
                else:
                    cancel event
                if click type is right mouse button:
                    cancel event
                    if {@genre} is "%{-server.genre.male}%":
                        close player's inventory
                        send "&7--------------- &7&lANTEPRIMA &7-----------------"
                        send ""
                        send "&8[&a+&8] &6%player% &esi è unito alla %{-server.name}%!"
                        send "&8[&c-&8] &6%player% &eha lasciato la %{-server.name}%!"
                        send ""
                        send "&7--------------- &7&lANTEPRIMA &7-----------------"
                        wait 5 seconds
                        openLogMessagesGui_1(player)
                    else if {@genre} is "%{-server.genre.female}%":
                        close player's inventory
                        send "&7--------------- &7&lANTEPRIMA &7-----------------"
                        send ""
                        send "&8[&a+&8] &6%player% &esi è unita alla %{-server.name}%!"
                        send "&8[&c-&8] &6%player% &eha lasciato la %{-server.name}%!"
                        send ""
                        send "&7--------------- &7&lANTEPRIMA &7-----------------"
                        wait 5 seconds
                        openLogMessagesGui_1(player)
                else:
                    cancel event

            else if index of event-slot is 12:
                if click type is left mouse button:
                    cancel event
                    if {logmsg.info.%player%} is not "{@vanilla}":
                        set {logmsg.info.%player%} to "{@vanilla}"
                        send "&6Hai selezionato: {@vanilla}&6!"
                        play sound "{@confirm_sound}" with volume 1 and pitch 2 at player for player
                        openLogMessagesGui_1(player)
                    else:
                        send "&cHai già selezionato questo pacchetto di messaggi!"
                        play sound "{@error_sound}" with volume 1 and pitch 0 at player for player
                else:
                    cancel event
                if click type is right mouse button:
                    cancel event
                    if {@genre} is "%{-server.genre.male}%":
                        close player's inventory
                        send "&7--------------- &7&lANTEPRIMA &7-----------------"
                        send ""
                        send "&8[&a+&8] &e%player% si è unito alla partita"
                        send "&8[&c-&8] &e%player% ha abbandonato la partita"
                        send ""
                        send "&7--------------- &7&lANTEPRIMA &7-----------------"
                        wait 5 seconds
                        openLogMessagesGui_1(player)
                    else if {@genre} is "%{-server.genre.female}%":
                        close player's inventory
                        send "&7--------------- &7&lANTEPRIMA &7-----------------"
                        send ""
                        send "&8[&a+&8] &e%player% si è unita alla partita"
                        send "&8[&c-&8] &e%player% ha abbandonato la partita"
                        send ""
                        send "&7--------------- &7&lANTEPRIMA &7-----------------"
                        wait 5 seconds
                        openLogMessagesGui_1(player)
                else:
                    cancel event

            else if index of event-slot is 13:
                if click type is left mouse button:
