            set slot 15 of {_gui} to player head with nbt from "{display:{Name:""{\""text\"":\""Emoticon Crazy\""}""},SkullOwner:{Id:[I;-2145492642,1031815816,-1083798970,2041625494],Properties:{textures:[{Value:""eyJ0ZXh0dXJlcyI6eyJTS0lOIjp7InVybCI6Imh0dHA6Ly90ZXh0dXJlcy5taW5lY3JhZnQubmV0L3RleHR1cmUvNDViMDU5NWE1MTFjNGIzNzc0MzdhNTE2ZmVmYmVhMmZmY2YzNTU4NWFlNTM0NjViMGU4NjAyNGEyMTVlYiJ9fX0=""}]}}}" named "{@funny}" with lore "&8Messaggi Server", "", "&7Diverti i tuoi amici con questo pacchetto", "&7di messaggi e... RIDICI SU!", "", "{@preview}", "" and "{@available}"
