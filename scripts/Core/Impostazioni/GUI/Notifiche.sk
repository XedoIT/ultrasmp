options:
    confirm_sound: play sound "block.note_block.pling" with volume 1 and pitch 2
    error_sound: play sound "entity.enderman.teleport" with volume 1 and pitch 0

  # GLINT
    glinted: "{enchantment_glint_override:true}"
    glinted_off: "{enchantment_glint_override:false}"
    
# MESSAGGI NOTIFICHE
    inventory_on: &7Avviso inventario pieno &aattivato&7.
    inventory_off: &7Avviso inventario pieno &cdisattivato&7.

    scoreboard_on: &7Promemoria scoreboard &aattivato&7.
    scoreboard_off: &7Promemoria scoreboard &cdisattivato&7.

  # ATTIVA/DISATTIVA
    turn_on: &eClicca per attivarle.
    turn_off: &eClicca per disattivarle.

  # MARKER
    no: &c✘
    yes: &a✔

# VARIABILI
    gui_background: {settings.personalization.gui_background::%{_p}%}

  # INIZIALIZZAZIONE
    initialized: {settings.alerts.initialized::%player%}

  # PRINCIPALI
    inventory_full: {settings.alerts.inventory_full::%player%}
    scoreboard_reminder: {settings.alerts.scoreboard_reminder::%player%}

    inventory_full_p: {settings.alerts.inventory_full::%{_p}%}
    scoreboard_reminder_p: {settings.alerts.scoreboard_reminder::%{_p}%}

  # MARKER PRINCIPALI
    inventory_full_marker: {-settings.alerts.inventory_full_marker::%player%}
    scoreboard_reminder_marker: {-settings.alerts.scoreboard_reminder_marker::%player%}

    inventory_full_p_marker: {-settings.alerts.inventory_full_marker::%{_p}%}
    scoreboard_reminder_p_marker: {-settings.alerts.scoreboard_reminder_marker::%{_p}%}

  # MARKER (GUI: PERSONALIZZAZIONE)
    gui_background_marker: {-settings.personalization.gui_background_marker::%{_p}%}
    wb_message_marker: {-settings.personalization.wb_message_marker::%{_p}%}
    scoreboard_marker: {-settings.personalization.scoreboard_marker::%{_p}%}
    can_view_other_profiles_marker: {-settings.personalization.view_other_profiles_marker::%{_p}%}
    damage_indicator_players_marker: {-settings.personalization.damage_indicator_players_marker::%{_p}%}
    damage_indicator_mobs_marker: {-settings.personalization.damage_indicator_mobs_marker::%{_p}%}

  # MARKER (GUI: PRIVACY)
    can_others_view_self_profile: {-settings.privacy.can_others_view_self_profile_marker::%{_p}%}
    can_receive_others_tp_requests: {-settings.privacy.can_receive_others_tp_requests_marker::%{_p}%}

# CONFIGURAZIONE VARIABILI
on join:
    # Default solo per i giocatori nuovi
    if {@initialized} is not set:
        set {@initialized} to true
        set {@inventory_full} to true
        set {@scoreboard_reminder} to true

    # Marker in base allo stato reale di ogni opzione
    set {@inventory_full_marker} to "{@no}"
    if {@inventory_full} is true:
        set {@inventory_full_marker} to "{@yes}"

    set {@scoreboard_reminder_marker} to "{@no}"
    if {@scoreboard_reminder} is true:
        set {@scoreboard_reminder_marker} to "{@yes}"

# ELIMINAZIONE MARKER
on quit:
    delete {@inventory_full_marker} and {@scoreboard_reminder_marker}

# INVENTARIO PIENO
function ToggleInventoryAlerts(p: player):
    if {@inventory_full_p} is not true:
        set {@inventory_full_p} to true
        set {@inventory_full_p_marker} to "{@yes}"
        {@confirm_sound} at {_p} for {_p}
        send "%{-server.prefix.main}% {@inventory_on}" to {_p}
    else:
        delete {@inventory_full_p}
        set {@inventory_full_p_marker} to "{@no}"
        {@confirm_sound} at {_p} for {_p}
        send "%{-server.prefix.main}% {@inventory_off}" to {_p}

# PROMEMORIA SCOREBOARD
function ToggleScoreboardAlerts(p: player):
    if {@scoreboard_reminder_p} is not true:
        set {@scoreboard_reminder_p} to true
        set {@scoreboard_reminder_p_marker} to "{@yes}"
        {@confirm_sound} at {_p} for {_p}
        send "%{-server.prefix.main}% {@scoreboard_on}" to {_p}
    else:
        delete {@scoreboard_reminder_p}
        set {@scoreboard_reminder_p_marker} to "{@no}"
        {@confirm_sound} at {_p} for {_p}
        send "%{-server.prefix.main}% {@scoreboard_off}" to {_p}


function openAlertsGui(p: player):
    set {_gui} to a new chest inventory with 6 rows named "Impostazioni: &9Notifiche"
    if {@gui_background} is true:
        set slot 0, 1, 3, 7, 8, 9, 17, 18, 26, 27, 35, 36, 44, 45, 46, 47, 50, 51, 52 and 53 of {_gui} to black stained glass pane named ""
        set slot 10, 11, 12, 13, 14, 15, 16, 19, 20, 22, 24, 25, 28, 29, 31, 33, 34, 37, 38, 39, 40, 41, 42 and 43 of {_gui} to gray stained glass pane named ""
    set slot 2 of {_gui} to nether star with nbt from {@glinted_off} named "&bRapide" with lore "&7Gestisci da qui le impostazioni", "&7più comuni per evitare perdite" and "&7di tempo."
    set slot 4 of {_gui} to comparator named "&aPersonalizzazione" with lore "&7Impostale a tuo piacimento!", "", "&7Include:", "%{@gui_background_marker}% &7Sfondo GUI", "%{@wb_message_marker}% &7Messaggio di bentornato", "%{@scoreboard_marker}% &7Scoreboard", "%{@can_view_other_profiles_marker}% &7Profilo giocatori &e[&7Tu &6&l→&e]", "%{@damage_indicator_players_marker}% &7Indicatore danni giocatori" and "%{@damage_indicator_mobs_marker}% &7Indicatore danni mob"
    set slot 5 of {_gui} to bell with nbt from {@glinted} named "&eNotifiche" with lore "&7Gestisci le notifiche che riceverai", "&7durante la tua avventura all'interno", "&7della %{-server.name}%.", "", "&7Include:", "%{@inventory_full_p_marker}% &7Inventario pieno" and "%{@scoreboard_reminder_p_marker}% &7Promemoria scoreboard"
    set slot 6 of {_gui} to iron bars named "&6Privacy" with lore "&7La sicurezza prima di tutto!", "", "&7Include:", "%{@can_others_view_self_profile}% &7Profilo giocatori &e[&7Tu &6&l←&e]" and "%{@can_receive_others_tp_requests}% &7Richieste teletrasporto"
    set slot 21 of {_gui} to chest named "&eInventario pieno" with lore "&7Ti verrà inviato un messaggio", "&7in chat e uno a schermo quando", "&7il tuo inventario non può più", "&7contenere altri oggetti.", "", "&4&lRICORDA!", " &cGli avvisi saranno inviati ogni", " &cminuto se il tuo inventario" and "&c sarà ancora pieno."
    set slot 23 of {_gui} to writable book named "&ePromemoria scoreboard" with lore "&7Ti verrà inviato un promemoria", "&7per mostrare nuovamente", "&7la scoreboard.", "", "&4&lRICORDA!", " &cIl promemoria sarà inviato" and " &cogni ora."
    if {@inventory_full_p} is true:
        set slot 30 of {_gui} to lime dye named "&aInventario pieno" with lore "{@turn_off}"
    else:
        set slot 30 of {_gui} to gray dye named "&cInventario pieno" with lore "{@turn_on}"
    if {@scoreboard_reminder_p} is true:
        set slot 32 of {_gui} to lime dye named "&aScoreboard" with lore "{@turn_off}"
    else:
        set slot 32 of {_gui} to gray dye named "&cScoreboard" with lore "{@turn_on}"
    set slot 48 of {_gui} to arrow named "&aIndietro" with lore "&7Torna a Profilo &7&lSMP"
    set slot 49 of {_gui} to barrier named "&cChiudi" with lore "&7Torna alla %{-server.name}%"
    open {_gui} to {_p}


on inventory click:
    if name of event-inventory is "Impostazioni: &9Notifiche":
        if type of event-inventory is chest inventory:
            if index of event-slot is not 2, 4, 5, 6, 30, 32, 48 or 49:
                cancel event
            else if index of event-slot is 2:
                if click type is left mouse button:
                    cancel event
                    openQuickSettingsGui(player)
                else:
                    cancel event
            else if index of event-slot is 4:
                if click type is left mouse button:
                    cancel event
                    openCustomPlayerSettingsGUI(player)
                else:
                    cancel event
            else if index of event-slot is 5:
                if click type is left mouse button:
                    cancel event
                    {@error_sound} at player for player
                else:
                    cancel event
            else if index of event-slot is 6:
                if click type is left mouse button:
                    cancel event
                    openPrivacyPlayerSettingsGUI(player)
                else:
                    cancel event
            else if index of event-slot is 30:
                if click type is left mouse button:
                    cancel event
                    ToggleInventoryAlerts(player)
                    openAlertsGui(player)
                else:
                    cancel event
            else if index of event-slot is 32:
                if click type is left mouse button:
                    cancel event
                    ToggleScoreboardAlerts(player)
                    openAlertsGui(player)
                else:
                    cancel event
            else if index of event-slot is 48:
                if click type is left mouse button:
                    cancel event
                    openProfileGui(player)
                else:
                    cancel event
            else if index of event-slot is 49:
                if click type is left mouse button:
                    cancel event
                    close player's inventory
                else:
                    cancel event


# ZONA DEBUG
command /resetalertssettings [<target: offline player>]:
    permission: debug.commands
    executable by: player and console
    suggestions:
        set the suggestions for the offline player argument to {players::*}
    trigger:
        if {_target} is not set:
            if sender is not player:
                send "&cSpecifica il nome di un giocatore."
            else:
                delete {settings.alerts.initialized.%player%}, {settings.alerts.inventory_full::%player%} and {settings.alerts.scoreboard_reminder::%player%}
                send "&cImpostazioni di notifiche di %player% eliminate."
        else:
            delete {settings.alerts.initialized.%{_target}%}, {settings.alerts.inventory_full::%{_target}%} and {settings.alerts.scoreboard_reminder::%{_target}%}
            send "&cImpostazioni di notifiche di %{_target}% eliminate."