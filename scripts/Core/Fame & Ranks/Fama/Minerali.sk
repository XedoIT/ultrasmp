            #cancel drops
            #drop 1 ancient debris named "Detriti antichi" at event-block's location

# ZONA DEBUG
command /debugpiazzati:
    permission: debug.commands
    trigger:
        send "Minerali segnati: %size of {fama.piazzati::*}%" to sender
        
command /sendorecolors:
    permission: debug.commands
    trigger:
        send "&8&lCARBONE &7+{Fama} Fama &3(%regex({fama::%player%})% totale)" to player
        send "&f&lFERRO &7+{Fama} Fama &3(%regex({fama::%player%})% totale)" to player
        send "&5&lRAME &d+{Fama} Fama &3(%regex({fama::%player%})% totale)" to player
        send "&e&lORO &6+{Fama} Fama &3(%regex({fama::%player%})% totale)" to player
        send "&4&lREDSTONE &c+{Fama} Fama &3(%regex({fama::%player%})% totale)" to player
        send "&1&lLAPIS &9+{Fama} Fama &3(%regex({fama::%player%})% totale)" to player
        send "&2&lSMERALDO &a+{Fama} Fama &3(%regex({fama::%player%})% totale)" to player
        send "&b&lDIAMANTE &9+{Fama} Fama &3(%regex({fama::%player%})% totale)" to player
        send "<##9966cc>&lAMETISTA &5+{Fama} Fama &3(%regex({fama::%player%})% totale)" to player
        send "&f&lQUARZO &7+{Fama} Fama &3(%regex({fama::%player%})% totale)" to player
        send "<##964b00>&lNETHERITE &7+{Fama} Fama &3(%regex({fama::%player%})% totale)" to player