#---------- FAMA: FUNZIONI ----------#
# Restituisce 1-9 (mondo + difficoltà del giocatore) oppure 0 se il mondo/difficoltà non è previsto
function famaIndice(p: player) :: number:
    if world of {_p} is "%{-server.world.overworld}%":
        set {_w} to 0
    else if world of {_p} is "%{-server.world.nether}%":
        set {_w} to 3
    else if world of {_p} is "%{-server.world.end}%":
        set {_w} to 6
    else:
        return 0
    if difficulty of {_p}'s world is easy:
        return {_w} + 1
    else if difficulty of {_p}'s world is normal (difficulty):
        return {_w} + 2
    else if difficulty of {_p}'s world is hard:
        return {_w} + 3
    return 0

# Applica la Fama al giocatore (guadagno o perdita in base al profilo) e manda l'action bar
function famaApplica(p: player, nome: text, fame: number, profilo: text):
    if gamemode of {_p} is creative or spectator:
        stop
    set {_i} to famaIndice({_p})
    if {_i} is 0:
        stop
    set {_prof::*} to {-fama.prof::%{_profilo}%::*}
    set {_m} to {_prof::%{_i} + 1%}
    set {_tot} to {_fame} * {_m}
    add ({_tot} * {_prof::1}) to {fama::%{_p}%}
    if {_prof::1} is 1:
        send action bar "&2☠ &2&l%{_nome}% &a+%regex({_tot})% Fama &6(%regex({fama::%{_p}%})% totale)" to {_p}
    else:
        send action bar "&4☠ &4&l%{_nome}% &c-%regex({_tot})% Fama &6(%regex({fama::%{_p}%})% totale)" to {_p}

#---------- FAMA: EVENTO UNICO ----------#
on death:
    if victim is a player:
        if {arenacombat} is true:
            stop
        if attacker is a player:
            famaApplica(attacker, "GIOCATORE", random number between 20 and 40, "giocatore")
            stop
        if gamemode of victim is creative or spectator:
            stop
        set {_i} to famaIndice(victim)
        if {_i} is 0:
            stop
        set {_prof::*} to {-fama.prof::morte::*}
        set {_fame} to random number between 15 and 20
        set {_tot} to {_fame} * {_prof::%{_i} + 1%}
        remove {_tot} from {fama::%victim%}
        send action bar "&4☠ &4&lMORTE &c-%regex({_tot})% Fama &6(%regex({fama::%victim%})% totale)" to victim
        stop
    if attacker is not a player:
        stop
    set {_k} to "%type of victim%"
    #send "&e&l[DEBUG] &fMob ucciso: %{_k}%" to attacker
    #send "&e&l[DEBUG] &fMob ucciso: %{_k}%" to console
    set {_d::*} to {-fama.mob::%{_k}%::*}
    if {_d::*} is not set:
        stop
    famaApplica(attacker, {_d::1}, random number between {_d::3} and {_d::4}, {_d::2})

on break of creaking heart:
    if "%block data of event-block%" does not contain "creaking_heart_state=awake":
        stop
    if "%block data of event-block%" does not contain "natural=true":
        stop
    set {_d::*} to {-fama.mob::creaking::*}
    famaApplica(player, {_d::1}, random number between {_d::3} and {_d::4}, {_d::2})