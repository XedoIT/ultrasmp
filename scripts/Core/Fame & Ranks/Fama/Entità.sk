#---------- FAMA: TABELLA DATI (caricata all'avvio dello script) ----------#
on load:
    delete {-fama.prof::*}
    delete {-fama.mob::*}

    # PROFILI: segno (1 = guadagna Fama, -1 = perde Fama) + 9 moltiplicatori
    # Ordine moltiplicatori: Overworld (easy, normal, hard) | Nether (easy, normal, hard) | End (easy, normal, hard)
