# file di gestione degli effetti ottenuti dalla Reputazione attuale #
#
# PERFIDO: Sfortuna, Debolezza 2, Affaticamento 2, Lentezza 2 (OGNI 30 MINUTI: Cecità - 30 secondi)
# MALVAGIO: Sfortuna, Debolezza 2, Affaticamento, Lentezza
# VILE: Sfortuna, Debolezza, Affaticamento
# SPREGEVOLE: Forza 2, Debolezza
# AGGRESSIVO: Forza 2
# NEUTRALE: -
# PERBENE: Fortuna
# GENTILE: Fortuna, Sollecitudine
# AFFIDABILE: Fortuna, Sollecitudine 2
# ALTRUISTA: Fortuna, Sollecitudine 2, Resistenza
# AFFABILE: Fortuna, Sollecitudine 2, Resistenza 2
# PURO: Fortuna, Sollecitudine 2, Resistenza 2, Rigenerazione
# MIGLIORE: Fortuna, Sollecitudine 2, Resistenza 2, Rigenerazione 2
# SPECIALE: Fortuna, Sollecitudine 2, Resistenza 2, Rigenerazione 2, Velocità
# STREPITOSO: Fortuna, Sollecitudine 2, Resistenza 2, Rigenerazione 2, Velocità 2
# STUPENDO: Fortuna, Sollecitudine 2, Resistenza 2, Rigenerazione 3, Velocità 2 (OGNI ORA: Eroe del villaggio - 15 minuti)

# ELIMINAZIONE VARIABILI CAUSA RANK UPDATE v2.0
on join:
    if {fama.%player%.effect} is set:
        set {rank.effect.%player%} to {fama.%player%.effect}
        delete {fama.%player%.effect}

on join:
    if {rank.effect.%player%} is not set:
        set {rank.effect.%player%} to "&7Non hai nessun effetto perché sei neutrale&7.%nl%&7Cambia reputazione per ottenerne uno."

every 59 ticks:
    loop all players:
        set {_u} to loop-player's uuid
        set {_r} to {rank.%{_u}%}
        if {_r} is {-rank.alignment.-5.%{_u}%}:
            set {rank.effect.%{_u}%} to "&f- &8Sfortuna%nl%&f- &eDebolezza II%nl%&f- &6Affaticamento II%nl%&f- &cLentezza II"
            apply an ambient potion effect of unluck to loop-player for 3 seconds:
                hide the particles
                hide the icon
            apply an ambient potion effect of weakness 2 to loop-player for 3 seconds:
                hide the particles
                hide the icon
            apply an ambient potion effect of mining fatigue 2 to loop-player for 3 seconds:
                hide the particles
                hide the icon
            apply an ambient potion effect of slowness 2 to loop-player for 3 seconds:
                hide the particles
                hide the icon
        else if {_r} is {-rank.alignment.-4.%{_u}%}:
            set {rank.effect.%{_u}%} to "&f- &8Sfortuna%nl%&f- &eDebolezza II%nl%&f- &6Affaticamento%nl%&f- &cLentezza"
            apply an ambient potion effect of unluck to loop-player for 3 seconds:
                hide the particles
                hide the icon
            apply an ambient potion effect of weakness 2 to loop-player for 3 seconds:
                hide the particles
                hide the icon
            apply an ambient potion effect of mining fatigue to loop-player for 3 seconds:
                hide the particles
                hide the icon
            apply an ambient potion effect of slowness to loop-player for 3 seconds:
                hide the particles
                hide the icon
        else if {_r} is {-rank.alignment.-3.%{_u}%}:
            set {rank.effect.%{_u}%} to "&f- &8Sfortuna%nl%&f- &eDebolezza%nl%&f- &6Affaticamento"
            apply an ambient potion effect of unluck to loop-player for 3 seconds:
                hide the particles
                hide the icon
            apply an ambient potion effect of weakness to loop-player for 3 seconds:
                hide the particles
                hide the icon
            apply an ambient potion effect of mining fatigue to loop-player for 3 seconds:
                hide the particles
                hide the icon
        else if {_r} is {-rank.alignment.-2.%{_u}%}:
            set {rank.effect.%{_u}%} to "&f- &8Forza II%nl%&f- &eDebolezza"
            apply an ambient potion effect of strength 2 to loop-player for 3 seconds:
                hide the particles
                hide the icon
            apply an ambient potion effect of weakness to loop-player for 3 seconds:
                hide the particles
                hide the icon
        else if {_r} is {-rank.alignment.-1.%{_u}%}:
            set {rank.effect.%{_u}%} to "&f- &8Forza II"
            apply an ambient potion effect of strength 2 to loop-player for 3 seconds:
                hide the particles
                hide the icon
        else if {_r} is {-rank.alignment.0.%{_u}%}:
            set {rank.effect.%{_u}%} to "&7Non hai nessun effetto perché sei neutrale&7.%nl%&7Cambia reputazione per ottenerne uno."
        else if {_r} is {-rank.alignment.1.%{_u}%}:
            set {rank.effect.%{_u}%} to "&f- &aFortuna"
            apply an ambient potion effect of luck to loop-player for 3 seconds:
                hide the particles
                hide the icon
        else if {_r} is {-rank.alignment.2.%{_u}%}:
            set {rank.effect.%{_u}%} to "&f- &aFortuna%nl%&f- &2Sollecitudine"
            apply an ambient potion effect of luck to loop-player for 3 seconds:
                hide the particles
                hide the icon
            apply an ambient potion effect of haste to loop-player for 3 seconds:
                hide the particles
                hide the icon
        else if {_r} is {-rank.alignment.3.%{_u}%}:
            set {rank.effect.%{_u}%} to "&f- &aFortuna%nl%&f- &2Sollecitudine II"
            apply an ambient potion effect of luck to loop-player for 3 seconds:
                hide the particles
                hide the icon
            apply an ambient potion effect of haste 2 to loop-player for 3 seconds:
                hide the particles
                hide the icon
        else if {_r} is {-rank.alignment.4.%{_u}%}:
            set {rank.effect.%{_u}%} to "&f- &aFortuna%nl%&f- &2Sollecitudine II%nl%&f- &3Resistenza"
            apply an ambient potion effect of luck to loop-player for 3 seconds:
                hide the particles
                hide the icon
            apply an ambient potion effect of haste 2 to loop-player for 3 seconds:
                hide the particles
                hide the icon
            apply an ambient potion effect of resistance to loop-player for 3 seconds:
                hide the particles
                hide the icon
        else if {_r} is {-rank.alignment.5.%{_u}%}:
            set {rank.effect.%{_u}%} to "&f- &aFortuna%nl%&f- &2Sollecitudine II%nl%&f- &3Resistenza II"
            apply an ambient potion effect of luck to loop-player for 3 seconds:
                hide the particles
                hide the icon
            apply an ambient potion effect of haste 2 to loop-player for 3 seconds:
                hide the particles
                hide the icon
            apply an ambient potion effect of resistance 2 to loop-player for 3 seconds:
                hide the particles
                hide the icon
        else if {_r} is {-rank.alignment.6.%{_u}%}:
            set {rank.effect.%{_u}%} to "&f- &aFortuna%nl%&f- &2Sollecitudine II%nl%&f- &3Resistenza II%nl%&f- &9Rigenerazione"
            apply an ambient potion effect of luck to loop-player for 3 seconds:
                hide the particles
                hide the icon
            apply an ambient potion effect of haste 2 to loop-player for 3 seconds:
                hide the particles
                hide the icon
            apply an ambient potion effect of resistance 2 to loop-player for 3 seconds:
                hide the particles
                hide the icon
            apply an ambient potion effect of regeneration to loop-player for 3 seconds:
                hide the particles
                hide the icon
        else if {_r} is {-rank.alignment.7.%{_u}%}:
            set {rank.effect.%{_u}%} to "&f- &aFortuna%nl%&f- &2Sollecitudine II%nl%&f- &3Resistenza II%nl%&f- &9Rigenerazione II"
            apply an ambient potion effect of luck to loop-player for 3 seconds:
                hide the particles
                hide the icon
            apply an ambient potion effect of haste 2 to loop-player for 3 seconds:
                hide the particles
                hide the icon
            apply an ambient potion effect of resistance 2 to loop-player for 3 seconds:
                hide the particles
                hide the icon
            apply an ambient potion effect of regeneration 2 to loop-player for 3 seconds:
                hide the particles
                hide the icon
        else if {_r} is {-rank.alignment.8.%{_u}%}:
            set {rank.effect.%{_u}%} to "&f- &aFortuna%nl%&f- &2Sollecitudine II%nl%&f- &3Resistenza II%nl%&f- &9Rigenerazione II%nl%&f- &bVelocità"
            apply an ambient potion effect of luck to loop-player for 3 seconds:
                hide the particles
                hide the icon
            apply an ambient potion effect of haste 2 to loop-player for 3 seconds:
                hide the particles
                hide the icon
            apply an ambient potion effect of resistance 2 to loop-player for 3 seconds:
                hide the particles
                hide the icon
            apply an ambient potion effect of regeneration 2 to loop-player for 3 seconds:
                hide the particles
                hide the icon
            apply an ambient potion effect of speed to loop-player for 3 seconds:
                hide the particles
                hide the icon
        else if {_r} is {-rank.alignment.9.%{_u}%}:
            set {rank.effect.%{_u}%} to "&f- &aFortuna%nl%&f- &2Sollecitudine II%nl%&f- &3Resistenza II%nl%&f- &9Rigenerazione II%nl%&f- &bVelocità II"
            apply an ambient potion effect of luck to loop-player for 3 seconds:
                hide the particles
                hide the icon
            apply an ambient potion effect of haste 2 to loop-player for 3 seconds:
                hide the particles
                hide the icon
            apply an ambient potion effect of resistance 2 to loop-player for 3 seconds:
                hide the particles
                hide the icon
            apply an ambient potion effect of regeneration 2 to loop-player for 3 seconds:
                hide the particles
                hide the icon
            apply an ambient potion effect of speed 2 to loop-player for 3 seconds:
                hide the particles
                hide the icon
        else if {_r} is {-rank.alignment.10.%{_u}%}:
            set {rank.effect.%{_u}%} to "&f- &aFortuna%nl%&f- &2Sollecitudine II%nl%&f- &3Resistenza II%nl%&f- &9Rigenerazione III%nl%&f- &bVelocità II"
            apply an ambient potion effect of luck to loop-player for 3 seconds:
                hide the particles
                hide the icon
            apply an ambient potion effect of haste 2 to loop-player for 3 seconds:
                hide the particles
                hide the icon
            apply an ambient potion effect of resistance 2 to loop-player for 3 seconds:
                hide the particles
                hide the icon
            apply an ambient potion effect of regeneration 3 to loop-player for 3 seconds:
                hide the particles
                hide the icon
            apply an ambient potion effect of speed 2 to loop-player for 3 seconds:
                hide the particles
                hide the icon

every 30 minutes:
    loop all players:
        if {rank.%loop-player%} is {-rank.alignment.-5.%loop-player%}:
            apply an ambient potion effect of blindness to loop-player for 31 seconds:
                hide the particles

every hour:
    loop all players:
        if {rank.%loop-player%} is {-rank.alignment.10.%loop-player%}:
            apply an ambient potion effect of hero of the village to loop-player for 15 minutes:
                hide the particles