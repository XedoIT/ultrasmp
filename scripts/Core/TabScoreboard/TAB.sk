#
# DIPENDENZE:
#
# - SkRayFall
#

options:
# SESSO
    genre: {genre.%loop-player%}

# LINEE TAB
    title_line: %{-animation.UltraSMP}% &c&lBETA
    welcome_line_male: &b&l>> %{-animation.Benvenuto}% &c&l%loop-player%&6&l! &b&l<<
    welcome_line_female: &b&l>> %{-animation.Benvenuta}% &c&l%loop-player%&6&l! &b&l<<
    ow_line: &b&k0 &a&lOverworld &b&k0
    n_line: &4&k0 &c&lNether &4&k0
    e_line: &5&k0 &d&lEnd &5&k0
    fama_name: &f&lFama
    fama_value: &b%regex({fama::%loop-player%})%
    rank_name: &f&lReputazione
    rank_value: %{rank.%loop-player%}%
    pvp: %{pvp}%
    difficulty: &3Difficoltà: %{-difficulty.info}%
    calendar_name: &f&lCalendario reale
    date_ow: &2%placeholder "localtime_time_dd/MM/yyyy" from loop-player%
    hour_ow: &2%placeholder "localtime_time_HH:mm:ss" from loop-player%
    date_n: &4%placeholder "localtime_time_dd/MM/yyyy" from loop-player%
    hour_n: &4%placeholder "localtime_time_HH:mm:ss" from loop-player%
    date_e: &5%placeholder "localtime_time_dd/MM/yyyy" from loop-player%
    hour_e: &5%placeholder "localtime_time_HH:mm:ss" from loop-player%
    calendar_sep: &f-
    ow_separator_line: %{-animation.OverWorld}%
    n_separator_line: %{-animation.Nether}%
    e_separator_line: %{-animation.End}%

every tick:
    loop all players:
        set {_name} to loop-player's name
        set {_genre} to {@genre}
        if {difficulty.info.hardcore_death::%loop-player%} is not set:
            set loop-player's tab name to formatted "%{rank.prefix.%loop-player%}% &f%{_name}%"
        else:
            set loop-player's tab name to formatted "%{difficulty.info.hardcore_death.%loop-player%.marker}% &7&o%{_name}%"
        if {_genre} is "%{-server.genre.female}%":
            if world of loop-player is "%{-server.world.overworld}%":
                set tab header to "{@title_line}%nl%%nl%{@welcome_line_female}%nl%%nl%{@ow_line}%nl%{@ow_separator_line}" and footer to "{@ow_separator_line}%nl%%nl%{@fama_name}%nl%{@fama_value}%nl%%nl%{@rank_name}%nl%{@rank_value}%nl%%nl%{@pvp}%nl%%nl%{@difficulty}%nl%%nl%{@calendar_name}%nl%{@date_ow} {@calendar_sep} {@hour_ow}" for loop-player
            else if world of loop-player is "%{-server.world.nether}%":
                set tab header to "{@title_line}%nl%%nl%{@welcome_line_female}%nl%%nl%{@n_line}%nl%{@n_separator_line}" and footer to "{@n_separator_line}%nl%%nl%{@fama_name}%nl%{@fama_value}%nl%%nl%{@rank_name}%nl%{@rank_value}%nl%%nl%{@pvp}%nl%%nl%{@difficulty}%nl%%nl%{@calendar_name}%nl%{@date_n} {@calendar_sep} {@hour_n}" for loop-player
            else if world of loop-player is "%{-server.world.end}%":
                set tab header to "{@title_line}%nl%%nl%{@welcome_line_female}%nl%%nl%{@e_line}%nl%%{-animation.End}%" and footer to "%{-animation.End}%%nl%%nl%{@fama_name}%nl%{@fama_value}%nl%%nl%{@rank_name}%nl%{@rank_value}%nl%%nl%{@pvp}%nl%%nl%{@difficulty}%nl%%nl%{@calendar_name}%nl%{@date_e} {@calendar_sep} {@hour_e}" for loop-player
        else:
            if world of loop-player is "%{-server.world.overworld}%":
                set tab header to "{@title_line}%nl%%nl%{@welcome_line_male}%nl%%nl%{@ow_line}%nl%{@ow_separator_line}" and footer to "{@ow_separator_line}%nl%%nl%{@fama_name}%nl%{@fama_value}%nl%%nl%{@rank_name}%nl%{@rank_value}%nl%%nl%{@pvp}%nl%%nl%{@difficulty}%nl%%nl%{@calendar_name}%nl%{@date_ow} {@calendar_sep} {@hour_ow}" for loop-player
            else if world of loop-player is "%{-server.world.nether}%":
                set tab header to "{@title_line}%nl%%nl%{@welcome_line_male}%nl%%nl%{@n_line}%nl%{@n_separator_line}" and footer to "{@n_separator_line}%nl%%nl%{@fama_name}%nl%{@fama_value}%nl%%nl%{@rank_name}%nl%{@rank_value}%nl%%nl%{@pvp}%nl%%nl%{@difficulty}%nl%%nl%{@calendar_name}%nl%{@date_n} {@calendar_sep} {@hour_n}" for loop-player
            else if world of loop-player is "%{-server.world.end}%":
                set tab header to "{@title_line}%nl%%nl%{@welcome_line_male}%nl%%nl%{@e_line}%nl%%{-animation.End}%" and footer to "%{-animation.End}%%nl%%nl%{@fama_name}%nl%{@fama_value}%nl%%nl%{@rank_name}%nl%{@rank_value}%nl%%nl%{@pvp}%nl%%nl%{@difficulty}%nl%%nl%{@calendar_name}%nl%{@date_e} {@calendar_sep} {@hour_e}" for loop-player

every 2 seconds:
    loop all players:
        set {_ping} to ping of loop-player
        loop all players:
            set tab score of loop-player-1 to {_ping} for loop-player-2