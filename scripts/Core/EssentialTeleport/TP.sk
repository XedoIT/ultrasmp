# VERSIONE 1.1.1
# NOVITÀ v1.1.1: MODIFICA NOME DEL SISTEMA E DELLE VARIABILI
#
# PERMESSI
#
# et.admin.tptoggle
# et.admin.tpinfo
# et.admin.tphere
# et.admin.top
# et.admin.tpoffline
# et.admin.tpofflinehere
# et.admin.tphelp
# et.admin.tprandom.bypass.cooldown
# debug.commands
#
options:
# GENERALI
    prefix: &4[&6&lT&e&lP&4]
    
    time: 30
    time_unit: seconds
    time_unit_ita: secondi

    no: &c✘
    yes: &a✔

# TPR (teletrasporto casuale)
    tpr_world: smp
    tpr_world_nether: smp_nether
    #tpr_world_end: smp_the_end
    tpr_radius: 5000
    tpr_radius_nether: 1500
    #tpr_radius_end: 750
    tpr_attempts: 15
    tpr_cooldown: 300
    tpr_nether_min: 33
    tpr_nether_max: 120
    tpr_ground: grass block or dirt or coarse dirt or podzol or mycelium or rooted dirt or mud or sand or red sand or gravel or sandstone or red sandstone or stone or snow block or terracotta
    tpr_ground_nether: netherrack #or soul soil or crimson nylium or warped nylium
    #tpr_ground_end: end stone

# VARIABILI
    genre_p: {genre.%player%}
    genre_arg: {genre.%{_target}%}

    can_receive_others_tp_requests: {settings.privacy.can_receive_others_tp_requests::%player%}
    can_receive_others_tp_requests_arg: {settings.privacy.can_receive_others_tp_requests::%{_target}%}
    can_receive_others_tp_requests_marker: {-settings.privacy.can_receive_others_tp_requests_marker::%player%}
    can_receive_others_tp_requests_marker_arg: {-settings.privacy.can_receive_others_tp_requests_marker::%{_target}%}

on join:
    if {-et.tp_requests_totalcount::%player%} is not set:
        set {-et.tp_requests_totalcount::%player%} to 0
    if {-et.tp_requests_count::%player%} is not set:
        set {-et.tp_requests_count::%player%} to 0
    if {-et.tphere_requests_count::%player%} is not set:
        set {-et.tphere_requests_count::%player%} to 0
    if {et.last_online_loc.%player%} is set:
        teleport player to {et.last_online_loc.%player%}
        delete {et.last_online_loc.%player%}
        delete {et.last_loc.%player%} # Commentare se si rivuole il /back con l'ultima posizione prima di uscire al rientro

on quit:
    set {et.last_online_loc.%player%} to player's location

on teleport:
    if teleport cause is command or plugin:
        set {et.last_loc.%player%} to player's location

on death of player:
    set {et.last_loc.%victim%} to victim's location

command /back:
    description: Torna alla tua ultima posizione.
    executable by: player
    trigger:
        if {et.last_loc.%player%} is not set:
            send "{@prefix} &cNon ho trovato una posizione in cui teletrasportarti!"
            stop
        else:
            etTeleport(player, {et.last_loc.%player%})
            if {@genre_p} is "%{-server.genre.female}%":
                send "{@prefix} &7Ti ho portata alla tua ultima posizione."
                stop
            else:
                send "{@prefix} &7Ti ho portato alla tua ultima posizione."
                stop

command /tpa <target: offline player>:
    usage: {@prefix} &cComando incompleto.%nl%{@prefix} &cUtilizza &6/tpa <&egiocatore&6>&c.
    description: Invia una richiesta di teletrasporto a un giocatore.
    executable by: player
    suggestions:
        set the suggestions for the offline player argument to all players
    trigger:
        if {_target} is online:
            if {_target} is not player:
                if {-et.tp_requests_list::%{_target}%::*} does not contain player:
                    if {-et.tphere_requests_list::%{_target}%::*} does not contain player:
                        if {@can_receive_others_tp_requests_arg} is true:
                            if {et.tp_requests_blacklist::%{_target}%::*} does not contain player:
                                add player to {-et.tp_requests_list::%{_target}%::*}
                                add 1 to {-et.tp_requests_totalcount::%{_target}%}
                                add 1 to {-et.tp_requests_count::%{_target}%}
                                set {_id} to now
                                set {-et.tp_requests_id::%{_target}%::%player%} to {_id}
                                send "{@prefix} &6Hai inviato una richiesta di teletrasporto a &c%{_target}%&6." to player
                                send "{@prefix} &6Ha &c{@time} {@time_unit_ita} &6per accettare." to player
                                send ""
                                send formatted "{@prefix} &6Per annullare questa richiesta: <click:run_command:/tpcancel %{_target}%>&c&l[ANNULLA]</click>" to player
                                send "{@prefix} &c%player% &6vorrebbe venire da te. &6Hai &c{@time} {@time_unit_ita} &6per accettare." to {_target}
                                send "" to {_target}
                                send formatted "{@prefix} <hover:show_text:'&2Clicca qui per accettare la richiesta di &a%player%&2'><click:run_command:/tpaccept %player%>&a&l[ACCETTA&a]</click></hover><reset> <hover:show_text:'&4Clicca qui per rifiutare la richiesta di &c%player%&4'><click:run_command:/tpdeny %player%>&c&l[RIFIUTA&c&l]</click></hover><reset> &f| <hover:show_text:'&cClicca qui per bloccare &6%player%&c'><click:run_command:/tpblock %player%>&4&l[BLOCCA&4&l]</click></hover><reset> <hover:show_text:'&fClicca qui per ignorare questa richiesta'><click:run_command:/tpignore %player%>&7&l[IGNORA&7&l]</click></hover><reset> <hover:show_text:'&9Manda un messaggio privato a &b%player%&9'><click:suggest_command:/msg %player% >&b&l[MESSAGGIO&b&l]</click></hover><reset>" to {_target}
                                wait {@time} {@time_unit}
                                if {-et.tp_requests_id::%{_target}%::%player%} is {_id}:
                                    if {-et.tp_requests_list::%{_target}%::*} contains player:
                                        remove player from {-et.tp_requests_list::%{_target}%::*}
                                        subtract 1 from {-et.tp_requests_totalcount::%{_target}%}
                                        subtract 1 from {-et.tp_requests_count::%{_target}%}
                                        delete {-et.tp_requests_id::%{_target}%::%player%}
                                        send "{@prefix} &6%{_target}% &cnon ha accettato la tua richiesta di teletrasporto entro il tempo limite." to player
                                        send "{@prefix} &cLa tua richiesta di teletrasporto da parte di &6%player% &cè scaduta." to {_target}
                                        stop
                            else:
                                send "{@prefix} &6%{_target}% &cha bloccato le tue richieste di teletrasporto."
                                stop
                        else:
                            send "{@prefix} &6%{_target}% &cnon può ricevere richieste di teletrasporto."
                            stop
                    else:
                        send "{@prefix} &cDi recente hai chiesto a &6%{_target}% &cdi venire da te."
                        send "{@prefix} &cAttendi prima di inviare un'altra richiesta di teletrasporto!"
                        stop
                else:
                    send "{@prefix} &cHai già inviato una richiesta di teletrasporto a &6%{_target}%&c!"
                    stop
            else:
                if {@genre_p} is "%{-server.genre.female}%":
                    send "{@prefix} &cNon puoi usare questo comando su stessa!"
                    stop
                else:
                    send "{@prefix} &cNon puoi usare questo comando su stesso!"
                    stop
        else:
            send "{@prefix} &6%{_target}% &cè offline."
            stop

command /tpahere <target: offline player>:
    usage: {@prefix} &cComando incompleto.%nl%{@prefix} &cUtilizza &6/tpahere <&egiocatore&6>&c.
    description: Invia una richiesta di teletrasporto alla tua posizione a un giocatore.
    executable by: player
    trigger:
        if {_target} is online:
            if {_target} is not player:
                if {-et.tphere_requests_list::%{_target}%::*} does not contain player:
                    if {-et.tp_requests_list::%{_target}%::*} does not contain player:
                        if {@can_receive_others_tp_requests_arg} is true:
                            if {et.tp_requests_blacklist::%{_target}%::*} does not contain player:
                                add player to {-et.tphere_requests_list::%{_target}%::*}
                                add 1 to {-et.tp_requests_totalcount::%{_target}%}
                                add 1 to {-et.tphere_requests_count::%{_target}%}
                                set {_id} to now
                                set {-et.tp_requests_id::%{_target}%::%player%} to {_id}
                                send "{@prefix} &6Hai chiesto a &c%{_target}% &6di venire da te." to player
                                send "{@prefix} &6Ha &c{@time} {@time_unit_ita} &6per accettare." to player
                                send ""
                                send formatted "{@prefix} &6Per annullare questa richiesta: <click:run_command:/tpcancel %{_target}%>&c&l[ANNULLA]</click>" to player
                                if {@genre_p} is "%{-server.genre.female}%":
                                    send "{@prefix} &c%player% &6vorrebbe che tu andassi da lei. &6Hai &c{@time} {@time_unit_ita} &6per accettare." to {_target}
                                else:
                                    send "{@prefix} &c%player% &6vorrebbe che tu andassi da lui. &6Hai &c{@time} {@time_unit_ita} &6per accettare." to {_target}
                                send "" to {_target}
                                send formatted "{@prefix} <hover:show_text:'&2Clicca qui per accettare la richiesta di &a%player%&2'><click:run_command:/tpaccept %player%>&a&l[ACCETTA&a]</click></hover><reset> <hover:show_text:'&4Clicca qui per rifiutare la richiesta di &c%player%&4'><click:run_command:/tpdeny %player%>&c&l[RIFIUTA&c&l]</click></hover><reset> &f| <hover:show_text:'&cClicca qui per bloccare &6%player%&c'><click:run_command:/tpblock %player%>&4&l[BLOCCA&4&l]</click></hover><reset> <hover:show_text:'&fClicca qui per ignorare questa richiesta'><click:run_command:/tpignore %player%>&7&l[IGNORA&7&l]</click></hover><reset> <hover:show_text:'&9Manda un messaggio privato a &b%player%&9'><click:suggest_command:/msg %player% >&b&l[MESSAGGIO&b&l]</click></hover><reset>" to {_target}
                                wait {@time} {@time_unit}
                                if {-et.tp_requests_id::%{_target}%::%player%} is {_id}:
                                    if {-et.tphere_requests_list::%{_target}%::*} contains player:
                                        remove player from {-et.tphere_requests_list::%{_target}%::*}
                                        subtract 1 from {-et.tp_requests_totalcount::%{_target}%}
                                        subtract 1 from {-et.tphere_requests_count::%{_target}%}
                                        delete {-et.tp_requests_id::%{_target}%::%player%}
                                        send "{@prefix} &6%{_target}% &cnon ha accettato la tua richiesta di teletrasporto entro il tempo limite." to player
                                        send "{@prefix} &cLa tua richiesta di teletrasporto da parte di &6%player% &cè scaduta." to {_target}
                                        stop
                            else:
                                send "{@prefix} &6%{_target}% &cha bloccato le tue richieste di teletrasporto."
                                stop
                        else:
                            send "{@prefix} &6%{_target}% &cnon può ricevere richieste di teletrasporto."
                            stop
                    else:
                        if {@genre_arg} is "%{-server.genre.male}%":
                            send "{@prefix} &cDi recente hai chiesto a &6%{_target}% &cdi andare da lui."
                            send "{@prefix} &cAttendi prima di inviare un'altra richiesta di teletrasporto!"
                            stop
                        else:
                            send "{@prefix} &cDi recente hai chiesto a &6%{_target}% &cdi andare da lei."
                            send "{@prefix} &cAttendi prima di inviare un'altra richiesta di teletrasporto!"
                            stop
                else:
                    send "{@prefix} &cHai già inviato una richiesta di teletrasporto a &6%{_target}%&c!"
                    stop
            else:
                if {@genre_p} is "%{-server.genre.male}%":
                    send "{@prefix} &cNon puoi usare questo comando su te stesso!"
                    stop
                else:
                    send "{@prefix} &cNon puoi usare questo comando su te stessa!"
                    stop
        else:
            send "{@prefix} &6%{_target}% &cè offline."
            stop

command /tpaccept <target: offline player>:
    usage: {@prefix} &cComando incompleto.%nl%{@prefix} &cUtilizza &6/tpaccept <&egiocatore&6>&c.
    description: Accetta la richiesta di teletrasporto da parte di un giocatore.
    executable by: player
    suggestions:
        set the suggestions for the offline player argument to {-et.tp_requests_list::%player%::*} and {-et.tphere_requests_list::%player%::*}
    trigger:
        if {_target} is online:
            if {_target} is not player:
                if {-et.tp_requests_list::%player%::*} contains {_target}:
                    remove {_target} from {-et.tp_requests_list::%player%::*}
                    subtract 1 from {-et.tp_requests_totalcount::%player%}
                    subtract 1 from {-et.tp_requests_count::%player%}
                    etTeleport({_target}, player's location)
                else if {-et.tphere_requests_list::%player%::*} contains {_target}:
                    remove {_target} from {-et.tphere_requests_list::%player%::*}
                    subtract 1 from {-et.tp_requests_totalcount::%player%}
                    subtract 1 from {-et.tphere_requests_count::%player%}
                    etTeleport(player, {_target}'s location)
                else:
                    send "{@prefix} &6%{_target}% &cnon ti ha inviato richieste di teletrasporto di recente."
                    stop
                send "{@prefix} &6Hai accettato la richiesta di &c%{_target}%&6." to player
                send "{@prefix} &c%player% &6ha accettato la tua richiesta di teletrasporto." to {_target}
                stop
            else:
                if {@genre_p} is "%{-server.genre.male}%":
                    send "{@prefix} &cNon puoi usare questo comando su te stesso!"
                    stop
                else:
                    send "{@prefix} &cNon puoi usare questo comando su te stessa!"
                    stop
        else:
            send "{@prefix} &6%{_target}% &cè offline."
            stop

