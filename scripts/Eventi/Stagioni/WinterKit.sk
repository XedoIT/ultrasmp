command /winterkit:
    executable by: player, console
    trigger:
        if sender is player:
            set {_rs_season} to placeholder "rs_season_%{server.world.overworld}%" from player
            if {_rs_season} isn't "{@winter}":
                send "%{server.prefix.main}% &cPuoi utilizzare questo comando soltanto in inverno!"
                play sound "entity.enderman.teleport" with volume 1 and pitch 0 at player for player
                stop
            else:
                if player's inventory has enough space for 4 diamond sword:
                    if {winterkit.%player%} isn't set:
                        give 1 leather helmet with nbt from {@helmet} to player
                        give 1 leather chestplate with nbt from {@chestplate} to player
                        give 1 leather leggings with nbt from {@leggings} to player
                        give 1 leather boots with nbt from {@boots} to player
                        send "%{server.prefix.main}% &aCon questo set di armatura sarai al sicuro dal freddo dell'inverno!"
                        send "%{server.prefix.main}% &6Fai attenzione a dove lo metti, non puoi richiederne un altro."
                        play sound "block.note_block.pling" with volume 1 and pitch 2 at player for player
                        set {winterkit.%player%} to true
                        stop
                    else:
                        send "%{server.prefix.main}% &cHai già ottenuto questo set di armatura!"
                        play sound "entity.enderman.teleport" with volume 1 and pitch 0 at player for player
                        stop
                else:
                    send "%{server.prefix.main}% &cPer questo kit sono richiesti almeno &64 slot liberi &cnel tuo inventario!"
                    send "%{server.prefix.main}% &cFai spazio e riprova."
                    play sound "entity.enderman.teleport" with volume 1 and pitch 0 at player for player
                    stop
        else:
            send "%{server.prefix.main}% &cSolo i giocatori possono eseguire questo comando!"
            stop


# ZONA DEBUG
options:
    debug_prefix: &8[&4&lDEBUG&8]

command /resetwinterkit [<offline player>]:
    permission: debug.commands
    permission message: &4[&6&lS&e&lM&6&lP&4] &cComando sconosciuto.
    trigger:
        if arg-1 isn't set:
            delete {winterkit.%player%}
            send "{@debug_prefix} &aDa adesso è come se non avessi mai avuto l'armatura per l'inverno."
            stop
        else:
            if arg-1 isn't player:
                delete {winterkit.%arg-1%}
                send "{@debug_prefix} &aDa adesso è come se &e%arg-1% &anon avesse mai avuto l'armatura per l'inverno."
                stop
            else:
                send "{@debug_prefix} &cPer indicare il tuo personaggio è sufficiente eseguire il comando senza parametri."
                stop
