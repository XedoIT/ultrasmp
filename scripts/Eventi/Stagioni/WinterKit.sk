    helmet: "{custom_name:'{""bold"":true,""color"":""aqua"",""text"":""Cappello pesante""}',lore:['{""color"":""green"",""italic"":false,""text"":""Indistruttibile""}','{""text"":"""",""color"":""white"",""bold"":true}','{""color"":""gray"",""text"":""Un ottimo modo per giocare""}','{""color"":""gray"",""text"":""l\'SMP al calduccio.""}'],unbreakable:{show_in_tooltip:false},enchantment_glint_override:true,hide_additional_tooltip:{}}"
    chestplate: "{custom_name:'{""bold"":true,""color"":""aqua"",""text"":""Giacca pesante""}',lore:['{""color"":""green"",""italic"":false,""text"":""Indistruttibile""}','{""text"":"""",""color"":""white"",""bold"":true}','{""color"":""gray"",""text"":""Un ottimo modo per giocare""}','{""color"":""gray"",""text"":""l\'SMP al calduccio.""}'],unbreakable:{show_in_tooltip:false},enchantment_glint_override:true,hide_additional_tooltip:{}}"
    leggings: "{custom_name:'{""bold"":true,""color"":""aqua"",""text"":""Pantaloni pesanti""}',lore:['{""color"":""green"",""italic"":false,""text"":""Indistruttibile""}','{""text"":"""",""color"":""white"",""bold"":true}','{""color"":""gray"",""text"":""Un ottimo modo per giocare""}','{""color"":""gray"",""text"":""l\'SMP al calduccio.""}'],unbreakable:{show_in_tooltip:false},enchantment_glint_override:true,hide_additional_tooltip:{}}"
