        add "impostazioni.privacy.can-receive-others-tp-requests.enabled" to {_paths::*}
        add "impostazioni.privacy.can-receive-others-tp-requests.marker" to {_paths::*}
        add "impostazioni.actionbar.flymode.enabled" to {_paths::*}
        add "impostazioni.actionbar.flymode.marker" to {_paths::*}
