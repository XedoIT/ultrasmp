        add "generali.player-progress.bloody-stats.damage.suffered" to {_paths::*}
        add "generali.player-progress.bloody-stats.killstreak" to {_paths::*}
        add "generali.player-progress.collection-stats.broken-blocks" to {_paths::*}
        add "generali.player-progress.collection-stats.placed-blocks" to {_paths::*}
        add "generali.player-progress.collection-stats.fished-loots" to {_paths::*}
        set {_gen_tot} to 0
        set {_gen_set} to 0
        set {_bad} to 0
        loop {_paths::*}:
            set {_v} to yaml value loop-value from {_id}
            if loop-value starts with "generali":
                add 1 to {_gen_tot}
                if {_v} is set:
                    add 1 to {_gen_set}
            if {_v} is set:
                set {_t} to "%{_v}%"
                if {_t} contains {_a} or {_s}:
                    add 1 to {_bad}
                    replace all {_a} with "[AMP]" in {_t}
                    replace all {_s} with "[SEZ]" in {_t}
                    send "&c[COLORE] &f%loop-value% = %{_t}%"
        set {_m} to yaml value "impostazioni.personalization.gui-background.marker" from {_id}
        set {_t} to "%{_m}%"
        replace all {_a} with "[AMP]" in {_t}
        replace all {_s} with "[SEZ]" in {_t}
        send "&e[yamlscan] marker sfondo GUI = &f%{_t}%"
        send "&e[yamlscan] chiavi generali presenti: &f%{_gen_set}%/%{_gen_tot}%"
        send "&e[yamlscan] valori con colori: &f%{_bad}%"
