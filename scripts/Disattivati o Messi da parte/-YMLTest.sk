        add "impostazioni.notify.service.lag-issues.enabled" to {_paths::*}
        add "impostazioni.notify.service.lag-issues.marker" to {_paths::*}
        add "impostazioni.notify.service.scheduled-stops.enabled" to {_paths::*}
        add "impostazioni.notify.service.scheduled-stops.marker" to {_paths::*}
        add "impostazioni.privacy.can-others-view-self-profile.enabled" to {_paths::*}
